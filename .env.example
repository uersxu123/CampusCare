# Local development defaults; Docker Compose overrides container addresses.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:13306/mindbridge?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/0

# Ollama endpoints default to localhost in Python and host.docker.internal in Compose.
KNOWLEDGE_EMBEDDING_MODEL=bge-m3:latest
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
ALERT_EMAIL_DELIVERY_MODE=log

# Optional OpenAI-compatible backend (never commit a real API key).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
